{
  "expo": {
    "name": "FerreStock 360",
    "slug": "ferrestock360-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ferrestock",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ferrestock360.mobile"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.ferrestock360.mobile"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Permite seleccionar imágenes de productos desde tu fototeca.",
        "microphonePermission": false
      }]
    ]
  }
}
