# ---------------------------------------------------------------
# FerreStock360 Mobile - Variables de entorno (Expo)
# Copia este archivo como `.env` y completa los valores reales.
# Los valores EXPO_PUBLIC_* NO son secretos: se empaquetan en la app.
# ---------------------------------------------------------------

# --- Firebase (obtenidos en Firebase Console > Configuración del proyecto > Tus apps) ---
EXPO_PUBLIC_FIREBASE_API_KEY=TU_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdefghijklmnopqrstuv

# --- Google Sign-In (Google Cloud Console > APIs & Services > Credentials) ---
# Web client (obligatorio: funciona en Expo Go a través del proxy de Expo).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-abcdefghijklmnop.apps.googleusercontent.com
# Android client (opcional, para builds de desarrollo/producción con esquema propio).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client (opcional, para builds de desarrollo/producción).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
